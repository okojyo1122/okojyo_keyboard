#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC               &kp Q         &kp W    &kp E            &kp R        &kp T         &kp Y     &kp U      &kp I      &kp O    &kp P                &kp MINUS
&mt LEFT_CONTROL TAB  &kp A         &kp S    &kp D            &kp F        &kp G         &kp H     &kp J      &kp K      &kp L    &kp SEMI             &kp COLON
&kp LSHFT             &kp Z         &kp X    &kp C            &kp V        &kp B         &kp N     &kp M      &kp COMMA  &kp DOT  &mt RIGHT_ALT SLASH  &mt RIGHT_SHIFT BACKSLASH
                      &kp LEFT_WIN  &lt 1 A  &mt LANG2 LANG1  &lt 2 SPACE  &lt 4 DELETE  &kp BSPC  &kp ENTER                      &to 3
            >;
        };

        layer_1 {
            bindings = <
&none  &kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp SQT  &kp LS(RIGHT_BRACKET)  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE      &kp MINUS
&none  &none            &none              &none     &none       &none        &kp SQT  &kp DOUBLE_QUOTES      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON  &kp LS(SEMICOLON)
&none  &none            &none              &none     &none       &none        &none    &kp AT                 &kp LESS_THAN         &kp GREATER_THAN       &kp EQUAL      &none
       &none            &none              &none     &none       &none        &none    &none                                                               &to 0
            >;
        };

        layer_2 {
            bindings = <
&none  &none     &kp UP_ARROW  &none            &none  &none       &kp ASTERISK   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp LS(EQUAL)  &none
&none  &kp LEFT  &kp DOWN      &kp RIGHT_ARROW  &none  &none       &kp SLASH      &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS      &none
&none  &none     &none         &none            &none  &none       &kp KP_N0      &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp EQUAL      &kp DOT
       &none     &none         &none            &none  &kp DELETE  &kp BACKSPACE  &kp ENTER                        &to 0
            >;
        };

        layer_3 {
            bindings = <
&kt C_VOLUME_UP  &kt C_VOLUME_DOWN  &kt K_MUTE  &none   &none   &none   &bt BT_SEL 0  &bt BT_SEL 1  &none   &none    &none    &none
&kp F1           &kt F2             &kt F3      &kt F4  &kp F5  &kt F6  &kp F7        &kp F8        &kp F9  &kp F10  &kp F11  &kp F12
&none            &none              &none       &none   &none   &none   &none         &none         &none   &none    &none    &none
                 &trans             &none       &none   &none   &none   &none         &none                          &to 0
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &msc SCRL_UP  &msc SCRL_DOWN  &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &msc SCRL_LEFT  &mkp LCLK     &mkp RCLK       &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans        &trans          &trans           &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans          &trans                                         &to 0
            >;
        };
    };
};
