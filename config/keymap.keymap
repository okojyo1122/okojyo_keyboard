#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_lclk {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

        combo_rclk {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

        combo_mclk {
            timeout-ms = <50>;
            key-positions = <19 20 21>;
            bindings = <&mkp MCLK>;
        };

        combo_scrl_up {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&msc SCRL_UP>;
        };

        combo_scrl_dn {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB               &kp Q         &kp W      &kp E             &kp R        &kp T         &kp Y     &kp U      &kp I      &kp O    &kp P                &kp MINUS
&kp LEFT_CONTROL      &kp A         &kp S      &kp D             &kp F        &kp G         &kp H     &kp J      &kp K      &kp L    &kp SEMI             &kp SQT
&kp LSHFT             &kp Z         &kp X      &kp C             &kp V        &kp B         &kp N     &kp M      &kp COMMA  &kp DOT  &mt RIGHT_ALT SLASH  &mt RIGHT_SHIFT INT_YEN
                      &kp LEFT_WIN  &mt LANG2 LANG1  &lt 3 ESC  &lt 2 SPACE  &lt 1 DELETE  &kp BSPC  &kp ENTER                                           &to 3
            >;
        };

        layer_1 {
            bindings = <
&none  &kp LS(N1)   &kp LS(EQUAL)  &kp LS(N3)     &kp LS(N4)    &kp LS(N5)   &kp LS(RIGHT_BRACKET)  &kp RIGHT_BRACKET  &kp LS(N8)     &kp LS(N9)     &kp BACKSLASH  &kp LS(BACKSLASH)
&none  &kp LS(N6)   &kp EQUAL      &kp LS(COMMA)  &kp LS(DOT)   &none         &kp LEFT_BRACKET       &kp LS(N7)         &kp LS(N2)     &kp LS(MINUS)  &kp LS(SEMI)   &kp LS(SQT)
&none  &none        &none          &none          &none         &none         &kp LS(LEFT_BRACKET)   &kp SQT            &kp INT_YEN    &kp LS(INT_YEN) &kp LS(INT_RO) &kp LS(SLASH)
       &none        &none          &none          &none         &none         &none                  &none                                              &to 0
            >;
        };

        layer_2 {
            bindings = <
&none  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN    &kp HOME      &none       &msc SCRL_UP    &kp N7  &kp N8  &kp N9  &kp LS(SEMI)   &kp LS(MINUS)
&none  &kp LEFT     &kp DOWN      &kp RIGHT_ARROW  &kp END       &none       &msc SCRL_LEFT  &kp N4  &kp N5  &kp N6  &kp MINUS      &msc SCRL_RIGHT
&none  &none        &none         &kp LA(LEFT)     &kp LA(RIGHT) &none       &msc SCRL_DOWN  &kp N1  &kp N2  &kp N3  &kp N0         &kp DOT
       &none        &none         &none            &none         &kp DELETE  &kp BACKSPACE   &kp ENTER                               &to 0
            >;
        };

        layer_3 {
            bindings = <
&kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_MUTE  &none   &none   &none   &bt BT_SEL 0  &bt BT_SEL 1  &to 4   &none    &none    &none
&kp F1           &kp F2             &kp F3      &kp F4  &kp F5  &kp F6  &kp F7        &kp F8        &kp F9  &kp F10  &kp F11  &kp F12
&none            &none              &none       &none   &none   &none   &bt BT_CLR    &none         &none   &none    &none    &none
                 &trans             &none       &none   &none   &none   &none         &none                          &to 0
            >;
        };
        /*
         * ╔══════════════════════════════════════════════════════════════╗
         * ║  LAYER 4 — FPS（左手専用）L3の →L4 で切替                   ║
         * ╠══════════════════════════════════════════════════════════════╣
         * ║ ┌─────┬───┬───┬───┬───┬───┐                                ║
         * ║ │ ESC │ 1 │ 2 │ 3 │ 4 │ 5 │  右手はトラックボール（透過）  ║
         * ║ ├─────┼───┼───┼───┼───┼───┤                                ║
         * ║ │ TAB │ Q │ W │ E │ R │ T │                                ║
         * ║ ├─────┼───┼───┼───┼───┼───┤                                ║
         * ║ │LSft │ A │ S │ D │ F │ G │                                ║
         * ║ └─────┴───┴───┴───┴───┴───┘                                ║
         * ║   ┌──────┬──────┬───────┬──────┬──────┐                   ║
         * ║   │ Ctrl │ Alt  │ Space │  C   │  G   │ (右手: 透過)       ║
         * ║   │(屈み)│(リン)│(ジャンプ)│(屈み)│(グレ) │               ║
         * ╚══════════════════════════════════════════════════════════════╝
         */
        layer_4 {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T   &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp A   &kp S   &kp D   &kp F   &kp G   &trans  &trans  &trans  &trans  &trans  &trans
           &kp LCTRL  &kp LALT  &kp SPACE  &kp C   &kp G   &trans  &trans                  &to 0
            >;
        };
    };
};
